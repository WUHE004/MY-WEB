# ============================================
# 库存管理系统 - 环境变量配置示例
# 使用方法：复制此文件为 .env.local 并填入实际值
# ============================================

# ============================================
# 1. Supabase 数据库配置（必须）
# ============================================
# 获取方式：Supabase Dashboard → Settings → API

# Supabase 项目 URL（前端可公开）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase 服务密钥（保密，不要提交到代码仓库）
# 注意：使用 service_role key，不是 anon key！
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# 2. 阿里云短信服务（可选，开发环境可跳过）
# ============================================
# 获取方式：阿里云控制台 → 短信服务

# 阿里云 AccessKey ID
ALIYUN_SMS_ACCESS_KEY_ID=

# 阿里云 AccessKey Secret
ALIYUN_SMS_ACCESS_KEY_SECRET=

# 短信签名名称
ALIYUN_SMS_SIGN_NAME=

# 短信模板CODE
# 模板内容示例：您的验证码是${code}，5分钟内有效。
ALIYUN_SMS_TEMPLATE_CODE=

# ============================================
# 3. 快递100 API（可选，开发环境可跳过）
# ============================================
# 获取方式：https://www.kuaidi100.com/openapi/

# 快递100授权密钥
KUAIDI100_KEY=

# 快递100客户编号
KUAIDI100_CUSTOMER=

# ============================================
# 4. Agnes AI 模型（可选，用于图片/视频生成）
# ============================================

# Agnes API 密钥
AGNES_API_KEY=

# ============================================
# 5. 企业微信机器人（可选）
# ============================================

# 企业微信群机器人 Webhook URL
WECHAT_WEBHOOK_URL=

# 企业微信自建应用配置（可选）
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_CORP_ID=
WECHAT_CORP_SECRET=
WECHAT_AGENT_ID=

# ============================================
# 6. 其他可选配置
# ============================================

# 豆包 API 密钥
DOUBAO_API_KEY=

# 豆包模型端点 ID
DOUBAO_ENDPOINT_ID=

# 阿里云百炼 API 密钥
DASHSCOPE_API_KEY=

# Webhook 验证密钥
WEBHOOK_API_KEY=wps-webhook-key-change-me

# ============================================
# 开发环境提示
# ============================================
# - 开发环境下，不配置阿里云短信时，验证码会打印到控制台
# - 开发环境下，不配置快递100时，返回模拟物流数据
# - 生产环境请务必配置所有需要的环境变量
